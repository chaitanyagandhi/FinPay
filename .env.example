# FinPay local development environment.
#
# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env      (or: make env)
#
# .env is git-ignored. Every value below already has the same default baked into
# docker-compose.yml, so the stack starts without a .env file at all; this file exists to
# document what is overridable and to give you a place to change ports that clash with
# something else on your machine.
#
# These are local development values. Production deployments supply a distinct secret per
# service from the platform's secret store and never read this file.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Bootstrap superuser. Services do not use it; each connects as its own role
# (finpay_auth, finpay_wallet, ...) created by the initdb script.
POSTGRES_USER=finpay
POSTGRES_PASSWORD=finpay
POSTGRES_DB=finpay
POSTGRES_PORT=5432

# Password assigned to every per-service role at database initialisation time.
# Changing this after the first start has no effect until you run `make reset`,
# because the initdb script only runs against an empty data directory.
FINPAY_SERVICE_DB_PASSWORD=finpay

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=finpay
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# Host-facing port. Inside the compose network the broker is always kafka:9092.
KAFKA_PORT=29092

# KRaft cluster identifier. Must stay stable for the lifetime of the kafka-data
# volume; changing it makes the broker refuse to start against existing log dirs.
KAFKA_CLUSTER_ID=EtbvZy3HSVK1xcwCL1FydQ

# Kafka UI. 8080 is deliberately left free for the API gateway.
KAFKA_UI_PORT=8090

# ---------------------------------------------------------------------------
# Config server
# ---------------------------------------------------------------------------
# Every service authenticates against the config server with these credentials to fetch
# its configuration. Production supplies them from the platform's secret store.
CONFIG_SERVER_USERNAME=finpay
CONFIG_SERVER_PASSWORD=finpay
CONFIG_SERVER_PORT=8888
